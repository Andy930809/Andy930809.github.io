---
import type { ProjectItem } from '../i18n/copy';

interface Props {
	project: ProjectItem;
	labels: {
		highlightsLabel: string;
		stackLabel: string;
	};
	isFeatured?: boolean;
}

const { project, labels, isFeatured = false } = Astro.props;
---

<article class:list={['project-card', { 'is-featured': isFeatured }]} data-project-card>
	<div class="card-glow" data-glow></div>
	{
		project.image && (
			<div class="project-cover-wrap">
				<img class="project-cover" src={project.image} alt={project.title} loading="lazy" />
			</div>
		)
	}
	<div class="card-content">
		<div class="card-header">
			<h3 class="project-title">{project.title}</h3>
		</div>

		<p class="project-summary">{project.summary}</p>

		{
			project.highlights && project.highlights.length > 0 && (
				<div class="project-highlights">
					<p class="section-title">{labels.highlightsLabel}</p>
					<ul>
						{project.highlights.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
			)
		}

		<div class="project-stack">
			<p class="section-title">{labels.stackLabel}</p>
			<div class="chip-list">
				{project.stack.map((tag) => <span>{tag}</span>)}
			</div>
		</div>
	</div>
</article>

<script>
	function setupGlow() {
		const cards = document.querySelectorAll('[data-project-card]');
		cards.forEach((card) => {
			const glow = card.querySelector('[data-glow]') as HTMLElement;
			card.addEventListener('mousemove', (e: any) => {
				const rect = card.getBoundingClientRect();
				const x = e.clientX - rect.left;
				const y = e.clientY - rect.top;
				if (glow) {
					glow.style.setProperty('--mouse-x', `${x}px`);
					glow.style.setProperty('--mouse-y', `${y}px`);
				}
			});
		});
	}

	document.addEventListener('astro:page-load', setupGlow);
</script>

<style>
	.project-card {
		position: relative;
		display: flex;
		flex-direction: column;
		border-radius: var(--radius-md);
		border: 1px solid var(--line);
		background: var(--surface);
		overflow: hidden;
		transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
	}

	.project-card:hover {
		border-color: var(--line-strong);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
		transform: translateY(-2px);
	}

	.card-glow {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(
			800px circle at var(--mouse-x, 0) var(--mouse-y, 0),
			rgba(47, 75, 158, 0.12),
			rgba(47, 75, 158, 0.05) 20%,
			transparent 50%
		);
		opacity: 0;
		transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 1;
	}

	[data-theme='dark'] .card-glow {
		background: radial-gradient(
			600px circle at var(--mouse-x, 0) var(--mouse-y, 0),
			rgba(124, 159, 255, 0.15),
			transparent 40%
		);
	}

	.project-card:hover .card-glow {
		opacity: 1;
	}

	.project-cover-wrap {
		position: relative;
		z-index: 2;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--surface-soft);
		border-bottom: 1px solid var(--line);
	}

	.project-cover {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card-content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.5rem;
		height: 100%;
	}

	.project-card.is-featured {
		border-width: 2px;
		border-color: var(--text);
	}

	.is-featured .card-content {
		padding: 2rem;
		background: linear-gradient(to bottom right, transparent, var(--surface-soft));
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
	}

	.title-area {
		display: grid;
		gap: 0.4rem;
	}

	.project-title {
		font-size: 1.35rem;
		line-height: 1.2;
		color: var(--text-strong);
		margin: 0;
	}

	.is-featured .project-title {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
	}

	.project-summary {
		margin: 0;
		color: var(--text-subtle);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.project-highlights {
		display: grid;
		gap: 0.5rem;
		padding: 0.9rem 1rem;
		background: rgba(0, 0, 0, 0.02);
		border-radius: 12px;
		border: 1px solid var(--line);
	}

	.section-title {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-subtle);
	}

	.project-highlights ul {
		margin: 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.35rem;
		font-size: 0.9rem;
		color: var(--text-strong);
	}

	.project-stack {
		display: grid;
		gap: 0.55rem;
	}

	.chip-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.chip-list span {
		font-size: 0.75rem;
		padding: 0.25rem 0.6rem;
		background: var(--surface-soft);
		border: 1px solid var(--line);
		border-radius: 6px;
		color: var(--text-subtle);
	}
</style>
