---
import type { ProjectItem, ProjectStatus } from '../i18n/copy';
import type { SiteLang } from '../i18n/config';

interface Props {
	project: ProjectItem;
	lang: SiteLang;
	statusCopy: Record<ProjectStatus, string>;
	labels: {
		sourceLabel: string;
		highlightsLabel: string;
		openSourceLabel: string;
		draftHint: string;
	};
	isFeatured?: boolean;
}

const { project, statusCopy, labels, isFeatured = false } = Astro.props;
---

<article class:list={['project-card', { 'is-featured': isFeatured }]} data-project-card>
	<div class="card-glow" data-glow></div>
	<div class="card-content">
		<div class="card-header">
			<div class="title-area">
				{isFeatured && <span class="featured-badge">Featured Project</span>}
				<h3 class="project-title">{project.title}</h3>
			</div>
			<span class:list={['status-pill', `is-${project.status}`]}>
				{statusCopy[project.status]}
			</span>
		</div>

		<p class="project-summary">{project.summary}</p>

		{
			project.highlights && project.highlights.length > 0 && (
				<div class="project-highlights">
					<p class="highlights-title">{labels.highlightsLabel}</p>
					<ul>
						{project.highlights.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
			)
		}

		<div class="project-result-box">
			<p class="project-result">{project.result}</p>
		</div>

		<div class="chip-list">
			{project.stack.map((tag) => <span>{tag}</span>)}
		</div>

		<div class="card-footer">
			<div class="source-info">
				<span class="label">{labels.sourceLabel}</span>
				<code class="source-ref">{project.sourceRef}</code>
			</div>
			<div class="cta-area">
				{
					project.link ? (
						<a class="inline-link action-link" href={project.link} target="_blank" rel="noopener noreferrer">
							{labels.openSourceLabel}
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
						</a>
					) : (
						<span class="draft-hint">{labels.draftHint}</span>
					)
				}
			</div>
		</div>
	</div>
</article>

<script>
	function setupGlow() {
		const cards = document.querySelectorAll('[data-project-card]');
		cards.forEach((card) => {
			const glow = card.querySelector('[data-glow]') as HTMLElement;
			card.addEventListener('mousemove', (e: any) => {
				const rect = card.getBoundingClientRect();
				const x = e.clientX - rect.left;
				const y = e.clientY - rect.top;
				if (glow) {
					glow.style.setProperty('--mouse-x', `${x}px`);
					glow.style.setProperty('--mouse-y', `${y}px`);
				}
			});
		});
	}

	document.addEventListener('astro:page-load', setupGlow);
</script>

<style>
	.project-card {
		position: relative;
		display: flex;
		flex-direction: column;
		border-radius: var(--radius-md);
		border: 1px solid var(--line);
		background: var(--surface);
		overflow: hidden;
		transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
	}

	.project-card:hover {
		border-color: var(--line-strong);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
		transform: translateY(-2px);
	}

	.card-glow {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(
			800px circle at var(--mouse-x, 0) var(--mouse-y, 0),
			rgba(47, 75, 158, 0.12),
			rgba(47, 75, 158, 0.05) 20%,
			transparent 50%
		);
		opacity: 0;
		transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 1;
	}

	[data-theme='dark'] .card-glow {
		background: radial-gradient(
			600px circle at var(--mouse-x, 0) var(--mouse-y, 0),
			rgba(124, 159, 255, 0.15),
			transparent 40%
		);
	}

	.project-card:hover .card-glow {
		opacity: 1;
	}

	.card-content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
		padding: 1.5rem;
		height: 100%;
	}

	.project-card.is-featured {
		border-width: 2px;
		border-color: var(--text);
	}

	.is-featured .card-content {
		padding: 2rem;
		background: linear-gradient(to bottom right, transparent, var(--surface-soft));
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
	}

	.title-area {
		display: grid;
		gap: 0.4rem;
	}

	.featured-badge {
		font-size: 0.7rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-subtle);
	}

	.project-title {
		font-size: 1.35rem;
		line-height: 1.2;
		color: var(--text-strong);
	}

	.is-featured .project-title {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
	}

	.status-pill {
		display: inline-flex;
		align-items: center;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 600;
		border: 1px solid var(--line);
		white-space: nowrap;
	}

	.status-pill.is-published {
		border-color: #bdcdf7;
		background: #edf2ff;
		color: #2f4b9e;
	}

	.status-pill.is-draft {
		background: var(--surface-soft);
		color: var(--text-subtle);
	}

	.project-summary {
		margin: 0;
		color: var(--text-subtle);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.project-highlights {
		display: grid;
		gap: 0.5rem;
		padding: 0.85rem;
		background: rgba(0, 0, 0, 0.02);
		border-radius: 12px;
	}

	.highlights-title {
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-subtle);
	}

	.project-highlights ul {
		margin: 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.35rem;
		font-size: 0.9rem;
		color: var(--text-strong);
	}

	.project-result-box {
		padding-left: 0.85rem;
		border-left: 2px solid var(--line-strong);
	}

	.project-result {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--text-strong);
	}

	.chip-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.chip-list span {
		font-size: 0.75rem;
		padding: 0.25rem 0.6rem;
		background: var(--surface-soft);
		border: 1px solid var(--line);
		border-radius: 6px;
		color: var(--text-subtle);
	}

	.card-footer {
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid var(--line);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.source-info {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
	}

	.source-info .label {
		color: var(--text-subtle);
	}

	.source-ref {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		padding: 0.1rem 0.4rem;
		background: var(--surface-soft);
		border-radius: 4px;
		color: var(--text-strong);
	}

	.action-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.9rem;
		font-weight: 650;
	}

	.action-link:hover {
		color: var(--text);
	}

	.draft-hint {
		font-size: 0.85rem;
		color: var(--text-subtle);
		font-style: italic;
	}

	@media (max-width: 640px) {
		.card-header {
			flex-direction: column;
			align-items: flex-start;
		}
		
		.card-footer {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
