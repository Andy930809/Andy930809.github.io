---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { CONTACT_LINKS, getSiteCopy } from '../../i18n/copy';
import { SUPPORTED_LANGS, type SiteLang } from '../../i18n/config';

export async function getStaticPaths() {
	return SUPPORTED_LANGS.map((lang) => ({
		params: { lang },
	}));
}

const lang = Astro.params.lang as SiteLang;
const copy = getSiteCopy(lang);
---

<SiteLayout lang={lang} title={copy.about.title} description={copy.siteDescription} pathname={Astro.url.pathname}>
	<section class="about-page panel">
		<div class="about-main">
			<p class="section-kicker">{copy.sections.about}</p>
			<h1>{copy.about.title}</h1>
			<p>{copy.about.intro}</p>
			<p>{copy.about.detail}</p>
			<div class="about-links">
				<a class="inline-link" href={CONTACT_LINKS.email}>Email</a>
				<a class="inline-link" href={CONTACT_LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
				<a class="inline-link" href={CONTACT_LINKS.bilibili} target="_blank" rel="noopener noreferrer">Bilibili</a>
			</div>
		</div>

		<aside class="about-side">
			<p class="section-kicker">{copy.about.skillsTitle}</p>
			<div class="chip-list">
				{copy.about.skills.map((skill) => <span>{skill}</span>)}
			</div>
		</aside>
	</section>
</SiteLayout>

<style>
	.about-page {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 2rem;
		flex-wrap: wrap;
	}

	.about-main,
	.about-side {
		flex: 1 1 320px;
		display: grid;
		gap: 0.8rem;
	}

	.about-page h1 {
		font-size: clamp(2.2rem, 5vw, 4rem);
	}

	.about-page p {
		max-width: 60ch;
		color: var(--text-subtle);
	}

	.about-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}
</style>
