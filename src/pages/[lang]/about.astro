---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { CONTACT_LINKS, getSiteCopy } from '../../i18n/copy';
import { SUPPORTED_LANGS, type SiteLang } from '../../i18n/config';

export async function getStaticPaths() {
	return SUPPORTED_LANGS.map((lang) => ({
		params: { lang },
	}));
}

const lang = Astro.params.lang as SiteLang;
const copy = getSiteCopy(lang);
---

<SiteLayout lang={lang} title={copy.about.title} description={copy.siteDescription} pathname={Astro.url.pathname}>
	<section class="about-page">
		<div class="about-main surface-card">
			<p class="section-kicker">Profile</p>
			<h1 class="section-title">{copy.about.title}</h1>
			<p>{copy.about.intro}</p>
			<p>{copy.about.detail}</p>
			<div class="contact-group">
				<a href={CONTACT_LINKS.email}>changkt930809@gmail.com</a>
				<a href={CONTACT_LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
				<a href={CONTACT_LINKS.bilibili} target="_blank" rel="noopener noreferrer">Bilibili</a>
			</div>
		</div>
		<aside class="about-side surface-card">
			<p class="section-kicker">Skills</p>
			<h2>{copy.about.skillsTitle}</h2>
			<div class="chip-list">
				{copy.about.skills.map((skill) => <span>{skill}</span>)}
			</div>
		</aside>
	</section>
</SiteLayout>

<style>
	.about-page {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 1rem;
	}

	.about-main,
	.about-side {
		padding: 1.3rem;
		display: grid;
		gap: 0.9rem;
	}

	.about-main p {
		color: var(--text-subtle);
	}

	.contact-group {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}

	.contact-group a {
		font-weight: 700;
		color: var(--accent);
	}

	.about-side h2 {
		font-size: 1.45rem;
	}

	@media (max-width: 900px) {
		.about-page {
			grid-template-columns: 1fr;
		}
	}
</style>
