---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import { render } from 'astro:content';
import { getSiteCopy } from '../../../i18n/copy';
import { SUPPORTED_LANGS, createLocalizedPath, formatDateByLang, type SiteLang } from '../../../i18n/config';
import { getLocalizedPostDescription, getLocalizedPostTitle, getSortedPosts } from '../../../lib/blog';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return SUPPORTED_LANGS.flatMap((lang) =>
		posts.map((post) => ({
			params: { lang, slug: post.id },
			props: { post, lang },
		})),
	);
}

const { post, lang } = Astro.props;
const typedLang = lang as SiteLang;
const copy = getSiteCopy(typedLang);
const { Content, headings } = await render(post);
---

<SiteLayout
	lang={typedLang}
	title={getLocalizedPostTitle(post, typedLang)}
	description={getLocalizedPostDescription(post, typedLang)}
	pathname={Astro.url.pathname}
>
	<div class="post-layout">
		<article class="post-page panel">
			<a class="inline-link" href={createLocalizedPath(typedLang, '/blog')}>{copy.nav.blog}</a>
			<p class="meta-date">{formatDateByLang(post.data.pubDate, typedLang)}</p>
			<h1>{getLocalizedPostTitle(post, typedLang)}</h1>
			<p class="post-intro">{getLocalizedPostDescription(post, typedLang)}</p>
			<section class="post-content">
				<Content />
			</section>
		</article>
		<aside class="post-sidebar">
			<TableOfContents headings={headings} />
		</aside>
	</div>
</SiteLayout>

<style>
	.post-layout {
		display: grid;
		grid-template-columns: 1fr 280px;
		gap: 4rem;
	}

	.post-page {
		display: grid;
		gap: 0.9rem;
		max-width: 84ch;
		min-width: 0; /* Prevent overflow issues */
	}

	.post-page h1 {
		font-size: clamp(2.3rem, 5vw, 4rem);
	}

	.post-intro {
		max-width: 60ch;
		color: var(--text-subtle);
		font-size: 1.15rem;
		line-height: 1.5;
	}

	.post-sidebar {
		padding-top: 2rem;
	}

	@media (max-width: 1280px) {
		.post-layout {
			grid-template-columns: 1fr;
		}
		.post-sidebar {
			display: none;
		}
	}
</style>
