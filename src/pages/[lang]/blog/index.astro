---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getSiteCopy } from '../../../i18n/copy';
import { SUPPORTED_LANGS, createLocalizedPath, formatDateByLang, type SiteLang } from '../../../i18n/config';
import { getLocalizedPostDescription, getLocalizedPostTitle, getSortedPosts } from '../../../lib/blog';

export async function getStaticPaths() {
	return SUPPORTED_LANGS.map((lang) => ({
		params: { lang },
	}));
}

const lang = Astro.params.lang as SiteLang;
const copy = getSiteCopy(lang);
const posts = await getSortedPosts();
---

<SiteLayout lang={lang} title={copy.blog.title} description={copy.blog.intro} pathname={Astro.url.pathname}>
	<section class="blog-page panel">
		<p class="section-kicker">{copy.nav.blog}</p>
		<h1>{copy.blog.title}</h1>
		<p class="blog-intro">{copy.blog.intro}</p>
		<div class="chip-list">
			{copy.blog.categories.map((category) => <span>{category}</span>)}
		</div>

		{
			posts.length === 0 ? (
				<p>{copy.blog.empty}</p>
			) : (
				<div class="blog-list">
					{posts.map((post) => (
						<a class="blog-item" href={createLocalizedPath(lang, `/blog/${post.id}`)}>
							<p class="meta-date">{formatDateByLang(post.data.pubDate, lang)}</p>
							<h2>{getLocalizedPostTitle(post, lang)}</h2>
							<p>{getLocalizedPostDescription(post, lang)}</p>
							<span class="inline-link">{copy.blog.readMore}</span>
						</a>
					))}
				</div>
			)
		}
	</section>
</SiteLayout>

<style>
	.blog-page {
		display: grid;
		gap: 1rem;
	}

	.blog-page h1 {
		font-size: clamp(2.3rem, 5vw, 4rem);
	}

	.blog-intro,
	.blog-item p {
		max-width: 60ch;
		color: var(--text-subtle);
	}

	.blog-list {
		display: grid;
	}

	.blog-item {
		display: grid;
		gap: 0.45rem;
		padding: 1rem 0;
		border-top: 1px solid var(--line);
	}

	.blog-item h2 {
		font-size: clamp(1.35rem, 2.8vw, 2rem);
	}
</style>
