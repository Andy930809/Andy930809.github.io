---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { CONTACT_LINKS, getSiteCopy } from '../../i18n/copy';
import { SUPPORTED_LANGS, createLocalizedPath, formatDateByLang, type SiteLang } from '../../i18n/config';
import { getLocalizedPostTitle, getSortedPosts } from '../../lib/blog';

export async function getStaticPaths() {
	return SUPPORTED_LANGS.map((lang) => ({
		params: { lang },
	}));
}

const lang = Astro.params.lang as SiteLang;
const copy = getSiteCopy(lang);
const posts = await getSortedPosts();
const latestPost = posts[0];
const leadProject = copy.projects[0];
const supportingProjects = copy.projects.slice(1);

const labels: Record<SiteLang, { project: string; post: string; route: string }> = {
	'zh-cn': { project: '当前项目', post: '最新文章', route: '语言路由' },
	'zh-tw': { project: '目前項目', post: '最新文章', route: '語言路由' },
	en: { project: 'Current Project', post: 'Latest Post', route: 'Routes' },
};
---

<SiteLayout lang={lang} title={copy.siteName} description={copy.siteDescription} pathname={Astro.url.pathname}>
	<section class="home-hero">
		<div class="hero-main">
			<p class="section-kicker">{copy.siteName}</p>
			<h1>{copy.heroTitle}</h1>
			<p class="hero-subtitle">{copy.heroSubtitle}</p>
			<p class="hero-body">{copy.heroBody}</p>
			<div class="hero-actions">
				<a class="button" href={leadProject.link} target="_blank" rel="noopener noreferrer">GitHub</a>
				<a class="button-secondary" href={createLocalizedPath(lang, '/blog')}>{copy.nav.blog}</a>
			</div>
		</div>

		<div class="hero-meta">
			<div class="meta-row">
				<span class="meta-label">{labels[lang].project}</span>
				<strong>{leadProject.title}</strong>
			</div>
			<div class="meta-row">
				<span class="meta-label">{labels[lang].post}</span>
				{
					latestPost ? (
						<a class="inline-link" href={createLocalizedPath(lang, `/blog/${latestPost.id}`)}>
							{getLocalizedPostTitle(latestPost, lang)}
						</a>
					) : (
						<span>{copy.blog.empty}</span>
					)
				}
			</div>
			<div class="meta-row">
				<span class="meta-label">{labels[lang].route}</span>
				<strong>{SUPPORTED_LANGS.length}</strong>
			</div>
		</div>
	</section>

	<section class="home-section panel" id="projects">
		<div class="section-head">
			<p class="section-kicker">{copy.nav.projects}</p>
			<h2>{copy.sections.projects}</h2>
		</div>

		<div class="project-layout">
			<div class="project-main">
				<h3>{leadProject.title}</h3>
				<p>{leadProject.summary}</p>
				<p class="project-result">{leadProject.result}</p>
				<div class="chip-list">
					{leadProject.stack.map((tag) => <span>{tag}</span>)}
				</div>
			</div>

			<div class="project-list">
				{
					supportingProjects.map((project) => (
						<article class="project-item">
							<h4>{project.title}</h4>
							<p>{project.summary}</p>
							<p>{project.result}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="home-section panel">
		<div class="section-head">
			<p class="section-kicker">{copy.nav.blog}</p>
			<h2>{copy.sections.featuredPosts}</h2>
		</div>

		{
			latestPost ? (
				<a class="writing-row" href={createLocalizedPath(lang, `/blog/${latestPost.id}`)}>
					<div>
						<p class="meta-date">{formatDateByLang(latestPost.data.pubDate, lang)}</p>
						<h3>{getLocalizedPostTitle(latestPost, lang)}</h3>
					</div>
					<span class="inline-link">{copy.blog.readMore}</span>
				</a>
			) : (
				<p>{copy.blog.empty}</p>
			)
		}
	</section>

	<section class="home-section panel home-about">
		<div>
			<p class="section-kicker">{copy.sections.about}</p>
			<h2>{copy.about.title}</h2>
			<p>{copy.about.intro}</p>
			<p>{copy.about.detail}</p>
		</div>
		<div class="about-side">
			<div class="chip-list">
				{copy.about.skills.map((skill) => <span>{skill}</span>)}
			</div>
			<div class="hero-actions">
				<a class="button" href={CONTACT_LINKS.email}>{copy.nav.contact}</a>
				<a class="button-secondary" href={CONTACT_LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
			</div>
		</div>
	</section>
</SiteLayout>

<style>
	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.8fr);
		gap: 2rem;
		padding: 1rem 0 4rem;
	}

	.hero-main,
	.hero-meta {
		display: grid;
		gap: 1rem;
	}

	.hero-main h1 {
		font-size: clamp(2.6rem, 6vw, 5rem);
		max-width: 11ch;
	}

	.hero-subtitle {
		font-size: 1.06rem;
		font-weight: 500;
		color: var(--text-strong);
	}

	.hero-body,
	.project-main p,
	.project-item p,
	.home-about p {
		max-width: 60ch;
		color: var(--text-subtle);
	}

	.hero-actions,
	.project-layout,
	.writing-row,
	.home-about {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.hero-meta {
		align-content: start;
		padding-top: 0.25rem;
	}

	.meta-row,
	.project-item {
		display: grid;
		gap: 0.35rem;
		padding: 1rem 0;
		border-top: 1px solid var(--line);
	}

	.writing-row {
		padding: 1rem 0;
		border-top: 1px solid var(--line);
	}

	.project-layout,
	.home-about {
		justify-content: space-between;
		align-items: flex-start;
	}

	.project-main,
	.project-list,
	.about-side {
		flex: 1 1 320px;
		display: grid;
		gap: 1rem;
	}

	.project-result {
		color: var(--text-strong);
		font-weight: 500;
	}

	.writing-row {
		align-items: center;
		justify-content: space-between;
	}

	.writing-row h3,
	.project-main h3 {
		font-size: clamp(1.45rem, 2.8vw, 2.2rem);
	}

	@media (max-width: 860px) {
		.home-hero {
			grid-template-columns: 1fr;
			padding-bottom: 3rem;
		}

		.writing-row,
		.home-about,
		.project-layout {
			flex-direction: column;
		}
	}
</style>
