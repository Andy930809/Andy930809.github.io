---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { CONTACT_LINKS, getSiteCopy } from '../../i18n/copy';
import { SUPPORTED_LANGS, createLocalizedPath, formatDateByLang, type SiteLang } from '../../i18n/config';
import { getFeaturedPosts, getLocalizedPostDescription, getLocalizedPostTitle, getSortedPosts } from '../../lib/blog';

export async function getStaticPaths() {
	return SUPPORTED_LANGS.map((lang) => ({
		params: { lang },
	}));
}

const lang = Astro.params.lang as SiteLang;
const copy = getSiteCopy(lang);
const posts = await getSortedPosts();
const featuredPosts = getFeaturedPosts(posts, 3);
---

<SiteLayout lang={lang} title={copy.siteName} description={copy.siteDescription} pathname={Astro.url.pathname}>
	<section class="hero">
		<p class="section-kicker">Personal Homepage</p>
		<h1>{copy.heroTitle}</h1>
		<p class="hero-subtitle">{copy.heroSubtitle}</p>
		<p class="hero-body">{copy.heroBody}</p>
		<div class="hero-actions">
			<a class="action-primary" href={createLocalizedPath(lang, '/about')}>{copy.nav.about}</a>
			<a class="action-secondary" href={createLocalizedPath(lang, '/blog')}>{copy.nav.blog}</a>
		</div>
	</section>

	<section class="projects" id="projects">
		<div class="section-head">
			<p class="section-kicker">Work</p>
			<h2 class="section-title">{copy.sections.projects}</h2>
		</div>
		<div class="project-grid">
			{
				copy.projects.map((item) => (
					<article class="surface-card project-card">
						<div class="project-stack">
							{item.stack.map((tag) => (
								<span>{tag}</span>
							))}
						</div>
						<h3>{item.title}</h3>
						<p>{item.summary}</p>
						<p class="project-result">{item.result}</p>
						<a href={item.link} target="_blank" rel="noopener noreferrer">
							Open Link
						</a>
					</article>
				))
			}
		</div>
	</section>

	<section class="featured-posts">
		<div class="section-head">
			<p class="section-kicker">Writing</p>
			<h2 class="section-title">{copy.sections.featuredPosts}</h2>
		</div>
		<div class="post-grid">
			{
				featuredPosts.map((post) => (
					<a class="surface-card post-card" href={createLocalizedPath(lang, `/blog/${post.id}`)}>
						<p class="post-date">{formatDateByLang(post.data.pubDate, lang)}</p>
						<h3>{getLocalizedPostTitle(post, lang)}</h3>
						<p>{getLocalizedPostDescription(post, lang)}</p>
					</a>
				))
			}
		</div>
	</section>

	<section class="about-teaser surface-card">
		<p class="section-kicker">Profile</p>
		<h2 class="section-title">{copy.sections.about}</h2>
		<p>{copy.about.intro}</p>
		<p>{copy.about.detail}</p>
		<div class="teaser-actions">
			<a class="action-primary" href={createLocalizedPath(lang, '/about')}>{copy.nav.about}</a>
			<a class="action-secondary" href={CONTACT_LINKS.email}>
				{copy.nav.contact}
			</a>
		</div>
	</section>
</SiteLayout>

<style>
	.hero {
		display: grid;
		gap: 1rem;
		padding: clamp(2.2rem, 4vw, 3.6rem);
		border-radius: var(--radius-lg);
		border: 1px solid var(--line);
		background:
			linear-gradient(120deg, color-mix(in srgb, var(--accent-soft) 80%, transparent), transparent 55%),
			var(--surface);
		box-shadow: var(--shadow);
		animation: rise-in var(--duration-slow) ease both;
	}

	.hero h1 {
		font-size: clamp(2.4rem, 5vw, 4.4rem);
		max-width: 16ch;
	}

	.hero-subtitle {
		font-size: clamp(1.02rem, 1.9vw, 1.4rem);
		color: var(--text-subtle);
	}

	.hero-body {
		max-width: 68ch;
		color: var(--text-subtle);
	}

	.hero-actions {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.action-primary,
	.action-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.62rem 1rem;
		border-radius: 999px;
		font-size: 0.88rem;
		font-weight: 700;
		transition: transform var(--duration-fast) ease;
	}

	.action-primary {
		background: var(--accent);
		color: #fff;
	}

	.action-secondary {
		background: transparent;
		border: 1px solid var(--line);
		color: var(--text);
	}

	.action-primary:hover,
	.action-secondary:hover {
		transform: translateY(-2px);
	}

	.projects,
	.featured-posts {
		margin-top: clamp(2.4rem, 4vw, 4rem);
	}

	.section-head {
		display: flex;
		flex-direction: column;
		margin-bottom: 1rem;
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.project-card {
		padding: 1.2rem;
		display: grid;
		gap: 0.8rem;
	}

	.project-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.project-stack span {
		font-size: 0.72rem;
		font-weight: 700;
		padding: 0.26rem 0.56rem;
		border-radius: 999px;
		background: var(--accent-soft);
	}

	.project-card h3 {
		font-size: 1.4rem;
	}

	.project-card p {
		color: var(--text-subtle);
	}

	.project-result {
		font-weight: 600;
		color: var(--text);
	}

	.project-card a {
		font-weight: 700;
		color: var(--accent);
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.post-card {
		padding: 1.1rem;
		display: grid;
		gap: 0.6rem;
		transition:
			transform var(--duration-fast) ease,
			border-color var(--duration-fast) ease;
	}

	.post-card:hover {
		transform: translateY(-3px);
		border-color: var(--accent);
	}

	.post-date {
		font-size: 0.78rem;
		text-transform: uppercase;
		color: var(--text-subtle);
	}

	.post-card h3 {
		font-size: 1.22rem;
	}

	.post-card p {
		color: var(--text-subtle);
	}

	.about-teaser {
		margin-top: clamp(2.6rem, 4vw, 4rem);
		padding: 1.3rem;
		display: grid;
		gap: 0.9rem;
	}

	.about-teaser p {
		color: var(--text-subtle);
	}

	.teaser-actions {
		display: flex;
		gap: 0.7rem;
		flex-wrap: wrap;
	}

	@media (max-width: 980px) {
		.project-grid,
		.post-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 680px) {
		.project-grid,
		.post-grid {
			grid-template-columns: 1fr;
		}
	}

	@keyframes rise-in {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
