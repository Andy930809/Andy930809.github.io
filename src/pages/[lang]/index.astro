---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { CONTACT_LINKS, getSiteCopy } from '../../i18n/copy';
import { createLocalizedPath, formatDateByLang, SUPPORTED_LANGS, type SiteLang } from '../../i18n/config';
import { getLocalizedPostTitle, getSortedPosts } from '../../lib/blog';

export async function getStaticPaths() {
	return SUPPORTED_LANGS.map((lang) => ({
		params: { lang },
	}));
}

const lang = Astro.params.lang as SiteLang;
const copy = getSiteCopy(lang);
const posts = await getSortedPosts();
const latestPost = posts[0];

if (copy.projects.length === 0) {
	throw new Error(`No projects configured for ${lang}.`);
}

const publishedProjects = copy.projects.filter((project) => project.status === 'published');
const featuredProject = publishedProjects[0] ?? copy.projects[0];

const projectMetrics = {
	total: copy.projects.length,
	published: publishedProjects.length,
	draft: copy.projects.length - publishedProjects.length,
};
---

<SiteLayout lang={lang} title={copy.siteName} description={copy.siteDescription} pathname={Astro.url.pathname}>
	<section class="home-hero">
		<div class="hero-main">
			<p class="section-kicker">{copy.siteName}</p>
			<h1>{copy.heroTitle}</h1>
			<p class="hero-subtitle">{copy.heroSubtitle}</p>
			<p class="hero-body">{copy.heroBody}</p>
			<div class="hero-actions">
				<a class="button" href={createLocalizedPath(lang, '/projects')}>{copy.nav.projects}</a>
				<a class="button-secondary" href={createLocalizedPath(lang, '/blog')}>{copy.nav.blog}</a>
			</div>
		</div>

		<div class="hero-meta">
			<div class="meta-row">
				<span class="meta-label">{copy.projectBoard.metrics.total}</span>
				<strong>{projectMetrics.total}</strong>
			</div>
			<div class="meta-row">
				<span class="meta-label">{copy.projectBoard.metrics.published}</span>
				<strong>{projectMetrics.published}</strong>
			</div>
			<div class="meta-row">
				<span class="meta-label">{copy.projectBoard.metrics.draft}</span>
				<strong>{projectMetrics.draft}</strong>
			</div>
			<div class="meta-row">
				<span class="meta-label">{copy.projectBoard.metrics.latestPost}</span>
				{
					latestPost ? (
						<a class="inline-link" href={createLocalizedPath(lang, `/blog/${latestPost.id}`)}>
							{getLocalizedPostTitle(latestPost, lang)}
						</a>
					) : (
						<span>{copy.blog.empty}</span>
					)
				}
			</div>
		</div>
	</section>

	<section class="home-section panel" id="projects">
		<div class="section-head-with-link">
			<div class="section-head">
				<p class="section-kicker">{copy.projectBoard.featuredLabel}</p>
				<h2>{featuredProject.title}</h2>
			</div>
			<a class="inline-link view-all" href={createLocalizedPath(lang, '/projects')}>
				{copy.nav.projects} &rarr;
			</a>
		</div>

		<div class="featured-project-container">
			<ProjectCard 
				project={featuredProject} 
				lang={lang} 
				statusCopy={copy.projectBoard.status}
				labels={{
					sourceLabel: copy.projectBoard.sourceLabel,
					highlightsLabel: copy.projectBoard.highlightsLabel,
					openSourceLabel: copy.projectBoard.openSourceLabel,
					draftHint: copy.projectBoard.draftHint
				}}
				isFeatured={true}
			/>
		</div>
	</section>

	<section class="home-section panel">
		<div class="section-head">
			<p class="section-kicker">{copy.nav.blog}</p>
			<h2>{copy.sections.featuredPosts}</h2>
		</div>

		{
			latestPost ? (
				<a class="writing-row" href={createLocalizedPath(lang, `/blog/${latestPost.id}`)}>
					<div>
						<p class="meta-date">{formatDateByLang(latestPost.data.pubDate, lang)}</p>
						<h3>{getLocalizedPostTitle(latestPost, lang)}</h3>
					</div>
					<span class="inline-link">{copy.blog.readMore}</span>
				</a>
			) : (
				<p>{copy.blog.empty}</p>
			)
		}
	</section>

	<section class="home-section panel home-about">
		<div>
			<p class="section-kicker">{copy.sections.about}</p>
			<h2>{copy.about.title}</h2>
			<p>{copy.about.intro}</p>
			<p>{copy.about.detail}</p>
		</div>
		<div class="about-side">
			<div class="chip-list">
				{copy.about.skills.map((skill) => <span>{skill}</span>)}
			</div>
			<div class="hero-actions">
				<a class="button" href={CONTACT_LINKS.email}>{copy.nav.contact}</a>
				<a class="button-secondary" href={CONTACT_LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
			</div>
		</div>
	</section>
</SiteLayout>

<style>
	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
		gap: 2.2rem;
		padding: 1rem 0 4rem;
		align-items: start;
	}

	.hero-main,
	.hero-meta {
		display: grid;
		gap: 1rem;
	}

	.hero-main h1 {
		font-size: clamp(2.6rem, 6vw, 5rem);
		max-width: 11ch;
	}

	.hero-subtitle {
		font-size: 1.06rem;
		font-weight: 500;
		color: var(--text-strong);
	}

	.hero-body,
	.home-about p {
		max-width: 60ch;
		color: var(--text-subtle);
	}

	.hero-actions,
	.writing-row,
	.home-about {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.hero-meta {
		align-content: start;
		padding-top: 0.25rem;
		gap: 0;
	}

	.meta-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 0.85rem 0;
		border-top: 1px solid var(--line);
	}

	.section-head-with-link {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: 2rem;
		gap: 2rem;
	}

	.section-head {
		display: grid;
		gap: 0.6rem;
	}

	.view-all {
		font-size: 0.95rem;
		margin-bottom: 0.2rem;
	}

	.featured-project-container {
		max-width: 900px;
	}

	.writing-row {
		padding: 1rem 0;
		border-top: 1px solid var(--line);
		align-items: center;
		justify-content: space-between;
	}

	.writing-row h3 {
		font-size: clamp(1.35rem, 2.4vw, 1.95rem);
	}

	.about-side {
		display: grid;
		gap: 1.5rem;
		align-content: start;
	}

	@media (max-width: 980px) {
		.home-hero {
			grid-template-columns: 1fr;
			padding-bottom: 3rem;
		}
	}

	@media (max-width: 860px) {
		.writing-row,
		.home-about,
		.hero-actions {
			flex-direction: column;
		}
		
		.section-head-with-link {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}
	}
</style>
